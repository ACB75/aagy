{
  "ecc-safety-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -File scripts/bin/ecc-agy/safety-check.ps1",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "ecc-markdown-linter": {
    "PostToolUse": [
      {
        "matcher": "write_file",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -File scripts/bin/ecc-agy/hook-post-write.ps1",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -File scripts/bin/ecc-agy/hook-post-write.ps1",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
