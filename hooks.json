{
  "aagy-safety-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -File scripts/ps1/safety-check.ps1",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "aagy-markdown-linter": {
    "PostToolUse": [
      {
        "matcher": "write_file",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -File scripts/ps1/hook-post-write.ps1",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -File scripts/ps1/hook-post-write.ps1",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "aagy-self-improve": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/py/self_improve.py --capture-stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
