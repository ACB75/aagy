{
  "aagy-safety-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${AAGY_PLUGIN_ROOT}/scripts/py/hook_safety.py\" --format agy",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "aagy-markdown-linter": {
    "PostToolUse": [
      {
        "matcher": "write_file",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${AAGY_PLUGIN_ROOT}/scripts/py/hook_post_write.py\" --format agy",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${AAGY_PLUGIN_ROOT}/scripts/py/hook_post_write.py\" --format agy",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "aagy-self-improve": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${AAGY_PLUGIN_ROOT}/scripts/py/self_improve.py\" --capture-stop",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "aagy-shared-backlog": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${AAGY_PLUGIN_ROOT}/scripts/py/backlog.py\" --quiet checkpoint --agent agy --auto",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "aagy-worktree-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${AAGY_PLUGIN_ROOT}/scripts/py/agent_worktree.py\" guard --agent agy --format agy",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "write_file",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${AAGY_PLUGIN_ROOT}/scripts/py/agent_worktree.py\" guard --agent agy --format agy",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${AAGY_PLUGIN_ROOT}/scripts/py/agent_worktree.py\" guard --agent agy --format agy",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "aagy-private-guard": {
    "PreToolUse": [
      {
        "matcher": "view_file",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${AAGY_PLUGIN_ROOT}/scripts/py/local_private_guard.py\" --format agy",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${AAGY_PLUGIN_ROOT}/scripts/py/local_private_guard.py\" --format agy",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "write_file",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${AAGY_PLUGIN_ROOT}/scripts/py/local_private_guard.py\" --format agy",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "aagy-notify": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${AAGY_PLUGIN_ROOT}/scripts/py/aagy_notify.py\" --event stop --format agy",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "aagy-session-start": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${AAGY_PLUGIN_ROOT}/scripts/py/agent_worktree.py\" --quiet recycle --agent agy --if-merged",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python \"${AAGY_PLUGIN_ROOT}/scripts/py/aagy_ui.py\" --quiet repair",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "aagy-live-status": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${AAGY_PLUGIN_ROOT}/scripts/py/live_status.py\" --hook --event session_start --agent agy",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${AAGY_PLUGIN_ROOT}/scripts/py/live_status.py\" --hook --event stop --agent agy",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
