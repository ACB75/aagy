{
	"files.exclude": {
		"**/.git": true,
		"**/.svn": true,
		"**/.hg": true,
		"**/CVS": true,
		"**/.DS_Store": true,
		"**/Thumbs.db": true,
		"**/Desktop.ini": true,
		"**/ehthumbs.db": true,
		"**/__pycache__": true,
		"**/*.pyc": true,
		"**/*.pyo": true,
		"**/*.pyd": true,
		"**/.pytest_cache": true,
		"**/.mypy_cache": true,
		"**/.ruff_cache": true,
		"**/.coverage": true,
		"**/htmlcov": true,
		"**/*.egg-info": true,
		"**/node_modules": true,
		"**/dist": true,
		"**/build": true,
		"**/.cache": true,
		"**/coverage": true,
		"**/.nyc_output": true,
		"**/*.tsbuildinfo": true,
		"**/*.tmp": true,
		"**/*.bak": true,
		"**/*.backup": true,
		"**/*.swp": true,
		"**/*.swo": true,
		"**/*~": true,
		"**/.observer-tmp": true
	},
	"files.watcherExclude": {
		"**/.git/objects/**": true,
		"**/.git/subtree-cache/**": true,
		"**/node_modules/**": true,
		"**/__pycache__/**": true,
		"**/.pytest_cache/**": true,
		"**/.mypy_cache/**": true,
		"**/.ruff_cache/**": true,
		"**/dist/**": true,
		"**/build/**": true,
		"**/coverage/**": true,
		"**/.cache/**": true
	},
	"search.exclude": {
		"**/node_modules": true,
		"**/__pycache__": true,
		"**/*.pyc": true,
		"**/.pytest_cache": true,
		"**/.mypy_cache": true,
		"**/.ruff_cache": true,
		"**/dist": true,
		"**/build": true,
		"**/coverage": true,
		"**/.nyc_output": true,
		"**/.cache": true,
		"**/package-lock.json": true
	}
}
