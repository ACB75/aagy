#!/bin/sh
# Git hook: commit-msg
# Valida que el mensaje de commit cumpla el estándar Conventional Commit estructurado

if [ "$GIT_HOOKS_BYPASS" = "1" ]; then
    exit 0
fi

MSG_FILE="$1"
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ]; then
    REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
fi

PYTHON_BIN="python"
if command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="python3"
fi

"$PYTHON_BIN" "$REPO_ROOT/scripts/py/format_commit.py" --validate-file "$MSG_FILE" --strict
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo ""
    echo "[GIT HOOK ERROR] El mensaje de commit no cumple con el formato requerido."
    echo "Formato esperado: [type]-[projects]: <title> o type(project): <title>"
    echo "Ejemplo: [feat]-[ecc]: nueva funcionalidad implementada"
    echo "Y un cuerpo explicativo de al menos 20 caracteres."
    echo "Para omitir esta comprobacion en emergencias, use 'git commit --no-verify'."
    exit 1
fi

exit 0
