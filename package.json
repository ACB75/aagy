{
  "name": "aagy",
  "version": "4.0.0",
  "description": "Anything Antigravity (aagy) Master Ecosystem: Multi-distribution architecture hosting aagy and aagy-ecc",
  "private": true,
  "license": "MIT",
  "scripts": {
    "install:claude": "pwsh -NoProfile -File ./install.ps1 -Target aagy-ecc",
